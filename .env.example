# =============================================================================
# ClassPulse — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Database (PostgreSQL 16) ---
DB_URL=jdbc:postgresql://localhost:5432/classpulse
DB_USER=classpulse
DB_PASSWORD=classpulse_dev

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# Generate: openssl rand -hex 64
# Must be >= 64 chars for HS512
JWT_SECRET=change_me_must_be_at_least_64_chars_for_hs512_algorithm_security_x

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=classpulse

# --- Coturn (WebRTC TURN/STUN) ---
# Must match static-auth-secret in turnserver.conf
TURN_SECRET=classpulse_turn_dev_secret
TURN_SERVER=localhost:3478

# --- LiveKit SFU (video media plane) ---
# api-key / api-secret PHẢI khớp block keys: trong livekit.yaml. Secret >= 32 ký tự.
LIVEKIT_API_KEY=classpulse
LIVEKIT_API_SECRET=classpulse_livekit_dev_secret_change_me_min32chars
# URL browser dùng để kết nối LiveKit (trả về trong token response).
# Dev 1 máy: ws://localhost:7880. Test LAN: ws://<IP LAN host>:7880
LIVEKIT_URL=ws://localhost:7880
# IP mà LiveKit advertise cho ICE. Dev 1 máy: 127.0.0.1. Test LAN: <IP LAN host>
LIVEKIT_NODE_IP=127.0.0.1

# --- App ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev
