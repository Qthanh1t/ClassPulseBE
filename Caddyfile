# =============================================================================
# ClassPulse — Caddy edge (automatic HTTPS via Let's Encrypt)
# Domains are read from env (set in .env.prod): APP_DOMAIN, LIVEKIT_DOMAIN, MINIO_DOMAIN
# =============================================================================
{
	email {$ACME_EMAIL}
}

# ---- Main app: SPA + API + WebSocket + public object GET ----
{$APP_DOMAIN} {
	encode gzip zstd

	# MinIO public object download. Stored URLs are /storage/<bucket>/<obj>.
	# handle_path strips the /storage prefix before forwarding.
	handle_path /storage/* {
		reverse_proxy minio:9000
	}

	# REST API (FE base = /api/v1)
	handle /api/* {
		reverse_proxy backend:8080
	}

	# STOMP/SockJS WebSocket (Caddy auto-upgrades)
	handle /ws/* {
		reverse_proxy backend:8080
	}

	# SPA fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# ---- LiveKit signaling (browser connects wss://LIVEKIT_DOMAIN) ----
# Media (UDP 7882 / TCP 7881) goes DIRECT to the VPS public IP, not through Caddy.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}

# ---- MinIO S3 endpoint (presigned PUT uploads target this host) ----
{$MINIO_DOMAIN} {
	reverse_proxy minio:9000
}
