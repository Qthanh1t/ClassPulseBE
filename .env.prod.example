# =============================================================================
# ClassPulse — PRODUCTION env. Copy to .env.prod and fill in. NEVER commit.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =============================================================================

# --- Domains (DNS A records must already point to this VPS public IP) ---
APP_DOMAIN=classpulse.example.com
LIVEKIT_DOMAIN=livekit.example.com
MINIO_DOMAIN=minio.example.com
# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# --- VPS public IP (LiveKit advertises this for WebRTC media) ---
LIVEKIT_NODE_IP=203.0.113.10

# --- Database ---
DB_USER=classpulse
DB_PASSWORD=CHANGE_ME_strong_db_password

# --- JWT (generate: openssl rand -hex 64) — must be >= 64 chars for HS512 ---
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_64_and_paste_here_at_least_64_chars

# --- MinIO ---
MINIO_ROOT_USER=classpulse
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=classpulse

# --- LiveKit (api-secret MUST match keys: in livekit.prod.yaml; >= 32 chars) ---
LIVEKIT_API_KEY=classpulse
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret_min_32_chars_long_xxxxx
